<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;

class TrimStrings
{
    /**
     * Handle an incoming request.
     *
     * @param  \Illuminate\Http\Request  $request
     * @param  \Closure  $next
     * @return mixed
     */
    public function handle(Request $request, Closure $next)
    {
        $input = $request->all();

        $input = array_map(function ($item) {
            if (is_string($item)) {
                $item = trim($item);
            }

            return $item;
        }, $input);

        $request->merge($input);

        return $next($request);
    }
}